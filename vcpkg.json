{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "hzcc",
  "version": "0.1.0",
  "description": "An experimental C compiler implemented in C++17",
  "builtin-baseline": "e54ef0fcc9a82033a61e51002552a910a5d57282",
  "dependencies": [
    "abseil",
    "cli11",
    "gflags",
    "glog",
    "magic-enum",
    "re2",
    {
      "name": "glog",
      "platform": "linux",
      "features": ["unwind"]
    }
  ],
  "features": {
    "tests": {
      "description": "Build the GoogleTest unit test suite",
      "dependencies": ["gtest"]
    }
  }
}
