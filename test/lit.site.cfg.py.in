import os
import shlex
import lit

# CMake generates one site config per build configuration, using target paths.
lit_config.load_config(config, os.path.join(r'@CURRENT_TEST_ROOT@', 'lit.cfg.py'))
config.pipefail = False
config.test_source_root = r'@CURRENT_TEST_ROOT@'
config.test_exec_root = os.path.dirname(os.path.abspath(__file__))
config.environment['PYTHON_EXECUTABLE'] = r'@Python3_EXECUTABLE@'

filecheck_executable = r'$<TARGET_FILE:HZCC_FileCheck>'
hzcc_executable = r'$<TARGET_FILE:hzcc>'
for executable in (filecheck_executable, hzcc_executable):
    if not os.path.isfile(executable):
        lit_config.fatal('Missing test executable: ' + executable)

config.substitutions.append(('%FileCheck', shlex.quote(filecheck_executable)))
config.substitutions.append(('%mycc', shlex.quote(hzcc_executable)))
