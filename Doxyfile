# Configured by doc/CMakeLists.txt. Keep project choices here and use Doxygen
# defaults for presentation options so upgrades do not retain obsolete settings.
PROJECT_NAME           = hzcc
PROJECT_NUMBER         = "@PROJECT_VERSION@ (@GIT_HASH@)"
PROJECT_BRIEF          = "Experimental C compiler and legacy JVM backend"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@"
INPUT                  = "@PROJECT_SOURCE_DIR@/hzcc" "@PROJECT_SOURCE_DIR@/scripts"
FILE_PATTERNS          = *.h *.cc *.java *.py
# Parse ordinary Python docstrings as documentation rather than verbatim text.
PYTHON_DOCSTRING        = NO
RECURSIVE              = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"

# Extract undocumented entities too: check_doxygen audits their XML descriptions.
# Include private helpers, local types and experimental modules in that audit.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
# Require each interface to carry its own documentation for the coverage audit.
INHERIT_DOCS           = NO

ENABLE_PREPROCESSING   = YES
# INPUT already contains all owned files; do not follow legacy include paths.
SEARCH_INCLUDES        = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "PACKED=" "ALWAYS_INLINE=inline" "CONSTEXPR=constexpr" \
                         "HZCC_ENABLE_RUNTIME_CHECK=1" "NODISCARD="

QUIET                  = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@PROJECT_BINARY_DIR@/doxygen-warnings.log"
GENERATE_HTML          = YES
HTML_OUTPUT            = doxygen_html
GENERATE_TREEVIEW      = YES
GENERATE_XML           = YES
XML_OUTPUT             = doxygen_xml
GENERATE_LATEX         = @HZCC_DOC_GENERATE_LATEX@
LATEX_OUTPUT           = "@HZCC_DOC_LATEX_DIR@"
LATEX_HEADER           = "@HZCC_DOC_EMPTY_TEX@"
LATEX_FOOTER           = "@HZCC_DOC_EMPTY_TEX@"
USE_PDFLATEX           = YES
HAVE_DOT               = @HZCC_DOC_HAVE_DOT@
