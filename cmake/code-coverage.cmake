# Target-scoped coverage for HZCC's C++ compiler and tests.
# target_code_coverage(target [PUBLIC|INTERFACE] [ARGS ...] [EXCLUDE regex ...])
# Libraries receive instrumentation only. Executables also get ccov-<target>
# (run/capture), ccov-report-<target> (text), and ccov-export-<target> (Cobertura).
# Single-config XML: <build>/ccov/<target>.xml. Multi-config: ccov/<config>/<target>.xml.
include_guard(GLOBAL)

# Prefer the compiler's tools, then versioned siblings. AppleClang must never
# silently select an unrelated Homebrew LLVM installation from PATH.
function(_hzcc_coverage_find_tool variable tool)
    string(REGEX MATCH "^[0-9]+" major "${CMAKE_CXX_COMPILER_VERSION}")
    get_filename_component(compiler_real "${CMAKE_CXX_COMPILER}" REALPATH)
    get_filename_component(compiler_dir "${compiler_real}" DIRECTORY)
    if(NOT ${variable})
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-prog-name=${tool}"
            OUTPUT_VARIABLE candidate OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE result ERROR_QUIET)
        if(NOT result STREQUAL "0" OR NOT IS_ABSOLUTE "${candidate}" OR NOT EXISTS "${candidate}")
            unset(candidate)
            find_program(candidate NAMES "${tool}-${major}" "${tool}"
                HINTS "${compiler_dir}" NO_DEFAULT_PATH NO_CACHE)
        endif()
        if(NOT candidate AND CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
            find_program(xcrun xcrun REQUIRED)
            execute_process(COMMAND "${xcrun}" --find "${tool}"
                OUTPUT_VARIABLE candidate OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE result ERROR_QUIET)
            if(NOT result STREQUAL "0")
                unset(candidate)
            endif()
        elseif(NOT candidate)
            find_program(candidate NAMES "${tool}-${major}" "${tool}" NO_CACHE)
        endif()
        if(NOT candidate OR NOT EXISTS "${candidate}")
            message(FATAL_ERROR "Cannot find ${tool} for ${CMAKE_CXX_COMPILER}; set ${variable} explicitly")
        endif()
        set(${variable} "${candidate}" CACHE FILEPATH "Coverage tool matching the C++ compiler")
    endif()
    execute_process(COMMAND "${${variable}}" --version
        OUTPUT_VARIABLE version ERROR_VARIABLE version_error RESULT_VARIABLE result)
    string(REGEX MATCH "[0-9]+\\.[0-9]+(\\.[0-9]+)?" tool_version "${version}")
    string(REGEX MATCH "^[0-9]+" tool_major "${tool_version}")
    if(NOT result STREQUAL "0" OR NOT tool_major STREQUAL major)
        message(FATAL_ERROR "${variable}=${${variable}} does not match compiler ${CMAKE_CXX_COMPILER_VERSION}: ${version}${version_error}")
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND NOT tool_version VERSION_EQUAL CMAKE_CXX_COMPILER_VERSION)
        message(FATAL_ERROR "gcov ${tool_version} must match GCC ${CMAKE_CXX_COMPILER_VERSION}")
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND NOT version MATCHES "Apple LLVM")
        message(FATAL_ERROR "AppleClang coverage requires Apple LLVM tools: ${${variable}}")
    endif()
    mark_as_advanced(${variable})
endfunction()

if(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang)$")
    set(HZCC_COVERAGE_BACKEND LLVM)
    _hzcc_coverage_find_tool(LLVM_COV_PATH llvm-cov)
    _hzcc_coverage_find_tool(LLVM_PROFDATA_PATH llvm-profdata)
    set(coverage_python_module lcov_cobertura)
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(HZCC_COVERAGE_BACKEND GCC)
    _hzcc_coverage_find_tool(GCOV_PATH gcov)
    set(coverage_python_module gcovr)
else()
    message(FATAL_ERROR "Coverage requires a Clang or GCC C++ compiler")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" -c "import ${coverage_python_module}"
    RESULT_VARIABLE coverage_python_result ERROR_QUIET)
if(NOT coverage_python_result STREQUAL "0")
    message(FATAL_ERROR
        "Install ${coverage_python_module} into ${Python3_EXECUTABLE} to enable coverage")
endif()
set(CMAKE_COVERAGE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/ccov")

function(target_code_coverage target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "PUBLIC;INTERFACE" "" "ARGS;EXCLUDE")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR (ARG_PUBLIC AND ARG_INTERFACE))
        message(FATAL_ERROR "Unsupported target_code_coverage arguments for ${target}")
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "Unknown coverage target: ${target}")
    endif()
    get_target_property(already_enabled ${target} HZCC_COVERAGE_ENABLED)
    if(already_enabled)
        message(FATAL_ERROR "Coverage already configured for ${target}")
    endif()
    set_property(TARGET ${target} PROPERTY HZCC_COVERAGE_ENABLED TRUE)
    set(visibility PRIVATE)
    if(ARG_PUBLIC)
        set(visibility PUBLIC)
    elseif(ARG_INTERFACE)
        set(visibility INTERFACE)
    endif()
    if(HZCC_COVERAGE_BACKEND STREQUAL "LLVM")
        target_compile_options(${target} ${visibility} -fprofile-instr-generate -fcoverage-mapping)
        target_link_options(${target} ${visibility} -fprofile-instr-generate)
    else()
        target_compile_options(${target} ${visibility} --coverage)
        target_link_options(${target} ${visibility} --coverage)
    endif()
    get_target_property(target_type ${target} TYPE)
    if(NOT target_type STREQUAL "EXECUTABLE")
        return()
    endif()
    if(ARG_INTERFACE)
        message(FATAL_ERROR "Executable coverage cannot use INTERFACE-only instrumentation")
    endif()

    get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    set(report_root "${CMAKE_COVERAGE_OUTPUT_DIRECTORY}")
    if(multi_config)
        string(APPEND report_root "/$<CONFIG>")
    endif()
    # Bracket arguments preserve spaces and backslashes without shell quoting.
    set(config_file "${CMAKE_CURRENT_BINARY_DIR}/coverage/${target}-$<CONFIG>.cmake")
    file(GENERATE OUTPUT "${config_file}" CONTENT
"set(coverage_backend [==[${HZCC_COVERAGE_BACKEND}]==])
set(coverage_executable [==[$<TARGET_FILE:${target}>]==])
set(coverage_target [==[${target}]==])
set(coverage_args [==[${ARG_ARGS}]==])
set(coverage_excludes [==[${ARG_EXCLUDE}]==])
set(coverage_source_root [==[${CMAKE_SOURCE_DIR}]==])
set(coverage_binary_root [==[${CMAKE_BINARY_DIR}]==])
set(coverage_run_directory [==[${CMAKE_CURRENT_BINARY_DIR}]==])
set(coverage_report_root [==[${report_root}]==])
set(coverage_config_name [==[$<CONFIG>]==])
set(coverage_configurations [==[${CMAKE_CONFIGURATION_TYPES}]==])
set(coverage_python [==[${Python3_EXECUTABLE}]==])
set(coverage_llvm_cov [==[${LLVM_COV_PATH}]==])
set(coverage_llvm_profdata [==[${LLVM_PROFDATA_PATH}]==])
set(coverage_gcov [==[${GCOV_PATH}]==])
")
    foreach(action IN ITEMS run report export)
        if(action STREQUAL "run")
            set(name "ccov-${target}")
            set(dependency "${target}")
            set(aggregate ccov)
        else()
            set(name "ccov-${action}-${target}")
            set(dependency "ccov-${target}")
            set(aggregate "ccov-${action}")
        endif()
        add_custom_target(${name}
            COMMAND "${CMAKE_COMMAND}" "-Dcoverage_config=${config_file}"
                "-Dcoverage_action=${action}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CoverageRun.cmake"
            DEPENDS ${dependency}
            COMMENT "Coverage ${action}: ${target} ($<CONFIG>)"
            VERBATIM)
        if(NOT TARGET ${aggregate})
            add_custom_target(${aggregate})
        endif()
        add_dependencies(${aggregate} ${name})
    endforeach()
endfunction()
