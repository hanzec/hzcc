# Keep LCOV records for project-owned sources only. LLVM's exporter otherwise
# includes inline definitions instantiated from system and dependency headers.
file(STRINGS "${work}/all.lcov" lines)
set(filtered "")
set(keep FALSE)
foreach(line IN LISTS lines)
    if(line MATCHES "^SF:(.*)")
        get_filename_component(source "${CMAKE_MATCH_1}" REALPATH BASE_DIR "${coverage_source_root}")
        cmake_path(IS_PREFIX coverage_source_root "${source}" NORMALIZE in_source)
        cmake_path(IS_PREFIX coverage_binary_root "${source}" NORMALIZE in_build)
        set(keep "${in_source}")
        if(in_build OR source MATCHES "${dependency_pattern}")
            set(keep FALSE)
        endif()
        foreach(pattern IN LISTS coverage_excludes)
            if(source MATCHES "${pattern}")
                set(keep FALSE)
            endif()
        endforeach()
        set(line "SF:${source}")
    endif()
    if(keep)
        string(APPEND filtered "${line}\n")
    endif()
    if(line STREQUAL "end_of_record")
        set(keep FALSE)
    endif()
endforeach()
if(filtered STREQUAL "")
    message(FATAL_ERROR "No project-owned source coverage remains after filtering")
endif()
file(WRITE "${work}/coverage.lcov" "${filtered}")
